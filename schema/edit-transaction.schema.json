{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/mizzen/schema/edit-transaction.schema.json",
  "title": "Mizzen edit transaction",
  "description": "One versioned, all-or-nothing multi-file edit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task", "snapshot", "patches"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "patches"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "patches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["span", "replacement"],
              "properties": {
                "span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["line", "column", "endLine", "endColumn"],
                  "properties": {
                    "file": { "type": "string", "minLength": 1 },
                    "line": { "type": "integer", "minimum": 1 },
                    "column": { "type": "integer", "minimum": 1 },
                    "endLine": { "type": "integer", "minimum": 1 },
                    "endColumn": { "type": "integer", "minimum": 1 }
                  }
                },
                "expected": { "type": "string" },
                "replacement": { "type": "string" },
                "beforeHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "file"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["contains", "absent", "unchanged", "json-equals", "json-schema"] },
          "file": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "pointer": { "type": "string" },
          "value": {},
          "schema": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["contains", "absent", "unchanged"] } } },
            "then": { "required": ["text"] }
          },
          {
            "if": { "properties": { "kind": { "const": "json-equals" } } },
            "then": { "required": ["pointer", "value"] }
          },
          {
            "if": { "properties": { "kind": { "const": "json-schema" } } },
            "then": { "required": ["schema"] }
          }
        ]
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireBeforeHash": { "type": "boolean" },
        "validateContent": { "type": "boolean" },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "records": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
