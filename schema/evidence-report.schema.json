{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/mizzen/schema/evidence-report.schema.json",
  "title": "Mizzen evidence report",
  "description": "`.mizzen/evidence.json`, written by a build that has an `evidence.lock.json`: each claim's status and the outcome of every cited evidence ID, and the public summary of each pinned envelope.",
  "type": "object",
  "required": [
    "version",
    "snapshot",
    "asOf",
    "claims",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "snapshot": {
      "type": "string",
      "pattern": "\\S"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "surface",
          "behavior",
          "evidence",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "surface": {
            "type": "string",
            "pattern": "\\S"
          },
          "behavior": {
            "type": "string",
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "subject": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "page",
                  "behavior"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "status": {
            "enum": [
              "verified",
              "stale",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "status": {
                  "enum": [
                    "verified",
                    "stale",
                    "unverified"
                  ]
                },
                "reason": {
                  "enum": [
                    "invalid-subject",
                    "unknown-surface",
                    "missing-evidence",
                    "snapshot-mismatch",
                    "commit-mismatch",
                    "configuration-mismatch",
                    "artifact-mismatch",
                    "unrelated-evidence",
                    "nonpassing-tests",
                    "nonpassing-ci",
                    "future-evidence",
                    "expired-evidence"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sha256",
          "executedAt"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "test",
              "ci",
              "benchmark"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executedAt": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
