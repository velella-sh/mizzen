{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/mizzen/schema/site-attestation.schema.json",
  "title": "Mizzen site attestation",
  "description": "The detached attestation `mizzen published-site attest` prints and `published-site verify` checks offline: build provenance, the build hash and file hashes, the allowlisted evidence manifest, and an Ed25519 signature or an explicit unsigned marker. Format 1 allows no extra fields; a new field needs format 2.",
  "type": "object",
  "required": [
    "payload",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "format",
        "site",
        "sourceCommit",
        "snapshot",
        "engine",
        "theme",
        "builtOn",
        "build",
        "evidence",
        "signing"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": 1
        },
        "site": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "engine": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "theme": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+"
            }
          }
        },
        "builtOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "build": {
          "type": "object",
          "required": [
            "hash",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "snapshot",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "snapshot": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
            },
            "files": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "signing": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "algorithm"
              ],
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "none"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "algorithm",
                "keyId"
              ],
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "ed25519"
                },
                "keyId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
