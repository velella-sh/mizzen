{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mizzen page JSON",
  "description": "One `<url>/index.json` in the output folder: a page's URL, title, description, headings, source file, last change, and token count, so an agent reads the text and structure without parsing HTML. A record page adds a `record` object with the collection, the id, and the published fields; a list page adds a `list` object with its record ids, groups, and pagination. Keys are written in a fixed order and the file ends with a line feed.",
  "type": "object",
  "required": ["url", "title", "description", "headings", "source", "lastModified", "tokens"],
  "properties": {
    "url": {
      "type": "string",
      "description": "The page's output URL, including base."
    },
    "title": {
      "type": "string",
      "description": "The page's title as the build resolved it."
    },
    "description": {
      "type": ["string", "null"],
      "description": "The front matter description, trimmed; null when the page has none."
    },
    "headings": {
      "type": "array",
      "description": "Every heading in document order.",
      "items": {
        "type": "object",
        "required": ["depth", "id", "text"],
        "properties": {
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "The heading level."
          },
          "id": {
            "type": "string",
            "description": "The heading's anchor id."
          },
          "text": {
            "type": "string",
            "description": "The heading's plain text."
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string",
      "description": "The source file, relative to the site root, with forward slashes."
    },
    "lastModified": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The front matter last_modified_at as YYYY-MM-DD, or null when absent or unreadable."
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Estimated tokens in the page's Markdown body: its characters divided by four, rounded up."
    },
    "record": {
      "type": "object",
      "required": ["collection", "id", "fields"],
      "properties": {
        "collection": {
          "type": "string",
          "description": "The collection the record belongs to."
        },
        "id": {
          "type": "string",
          "description": "The record's id in its collection."
        },
        "fields": {
          "type": "object",
          "description": "The record's fields in the page's language: every field, or the fields the collection's `json.fields` names. The raw evidence field is never one of them."
        },
        "evidence": {
          "type": "object",
          "description": "Claims keyed by the field they back, in record field order; each claim has only its public id, title, and url. Absent when the record has none.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "url"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable id, unique within this field's list."
                },
                "title": {
                  "type": "string",
                  "description": "Readable label for the source."
                },
                "url": {
                  "type": "string",
                  "description": "Absolute https URL or root-relative path of the source."
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false,
      "description": "The record this page was built from."
    },
    "list": {
      "type": "object",
      "required": ["collection", "records", "groups", "pagination"],
      "properties": {
        "collection": {
          "type": "string",
          "description": "The collection the list shows."
        },
        "records": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ids of the records this page shows, in the list's order."
        },
        "groups": {
          "type": "array",
          "description": "The page's groups, when the list asks for groups; empty otherwise.",
          "items": {
            "type": "object",
            "required": ["key", "records"],
            "properties": {
              "key": {
                "type": "string",
                "description": "The group's value, as the list grouped it."
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "How many records the group holds, including on an index page where its records are empty."
              },
              "url": {
                "type": "string",
                "description": "The group's own page, when the list expands one page per group value."
              },
              "records": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Ids of the group's records on this page."
              }
            },
            "additionalProperties": false
          }
        },
        "pagination": {
          "type": "object",
          "required": ["page", "total"],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1,
              "description": "This page's number in the list."
            },
            "total": {
              "type": "integer",
              "minimum": 1,
              "description": "The list's number of pages."
            },
            "previous": {
              "type": "string",
              "description": "The previous page's URL, when there is one."
            },
            "next": {
              "type": "string",
              "description": "The next page's URL, when there is one."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "The list this page shows."
    },
    "stale": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The date the page was last marked as reviewed; absent when it never was."
        },
        "files": {
          "type": "array",
          "description": "The covered files that differ from the review lock, sorted by path.",
          "items": {
            "type": "object",
            "required": ["path", "change"],
            "properties": {
              "path": {
                "type": "string",
                "description": "Path relative to `stale.root`, with `/` separators."
              },
              "change": {
                "enum": ["changed", "removed", "added"],
                "description": "What happened to the file since the last review."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "The page's covered files that changed since it was last reviewed. Absent for a page without `covers` and for a current page."
    },
    "surface": {
      "type": "object",
      "required": ["coverage", "gaps", "exclusions"],
      "properties": {
        "coverage": {
          "type": "object",
          "required": ["counts", "documentedPercent", "undocumentedPercent", "areas"],
          "additionalProperties": false,
          "properties": {
            "counts": {
              "type": "object",
              "required": ["documented", "partial", "undocumented", "excluded", "total"],
              "additionalProperties": false,
              "properties": {
                "documented": { "type": "integer", "minimum": 0 },
                "partial": { "type": "integer", "minimum": 0 },
                "undocumented": { "type": "integer", "minimum": 0 },
                "excluded": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
              }
            },
            "documentedPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "undocumentedPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "areas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["area", "counts", "documentedPercent", "undocumentedPercent"],
                "additionalProperties": false,
                "properties": {
                  "area": { "enum": ["api", "cli", "config", "openapi", "data", "version"] },
                  "counts": {
                    "type": "object",
                    "required": ["documented", "partial", "undocumented", "excluded", "total"],
                    "additionalProperties": false,
                    "properties": {
                      "documented": { "type": "integer", "minimum": 0 },
                      "partial": { "type": "integer", "minimum": 0 },
                      "undocumented": { "type": "integer", "minimum": 0 },
                      "excluded": { "type": "integer", "minimum": 0 },
                      "total": { "type": "integer", "minimum": 0 }
                    }
                  },
                  "documentedPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "undocumentedPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        },
        "gaps": {
          "type": "integer",
          "minimum": 0,
          "description": "How many documentation gaps the surface report found."
        },
        "exclusions": {
          "type": "integer",
          "minimum": 0,
          "description": "How many documented exclusions the surface report holds."
        }
      },
      "additionalProperties": false,
      "description": "The public-surface coverage counts. Present only when the site config declares a `surface` key."
    }
  },
  "additionalProperties": false
}
