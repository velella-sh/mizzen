{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/mizzen/schema/docs-review.schema.json",
  "title": "Mizzen docs review lock",
  "description": "`docs-review.lock.json`: for each page that names the files it describes, those files' SHA-256 hashes and the date the page was last marked as reviewed.",
  "type": "object",
  "required": ["version", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "The format version. Only 1 exists."
    },
    "pages": {
      "type": "object",
      "description": "Reviewed pages keyed by the page's source path relative to the site root.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["reviewed", "files"],
      "additionalProperties": false,
      "properties": {
        "reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The review date: the commit date of `HEAD` or `--date`, never the system clock."
        },
        "files": {
          "type": "array",
          "description": "Covered files sorted by path.",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1, "description": "Path relative to `stale.root`, with `/` separators." },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the file's content with line ends normalized to LF." }
            }
          }
        }
      }
    }
  }
}
