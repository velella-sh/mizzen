{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/mizzen/schema/eval-suite.schema.json",
  "title": "Mizzen evaluation suite",
  "description": "A versioned list of case files and the engine and tool versions they pin. `parseEvalSuite` in `src/evals/case.ts` validates it and reports every problem with a JSON Pointer. Case paths are relative to the suite folder.",
  "type": "object",
  "required": ["version", "id", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 120 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mizzen": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
